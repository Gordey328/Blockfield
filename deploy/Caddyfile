{$BLOCKFIELD_DOMAIN} {
    @game {
        path /play
        header Origin https://gordey328.github.io
    }
    @map {
        path /map
        header Origin https://gordey328.github.io
    }
    handle @game {
        reverse_proxy blockfield:8765
    }
    handle @map {
        reverse_proxy blockfield:8766
    }
    handle {
        respond "Blockfield WebSocket endpoint" 404
    }
}
